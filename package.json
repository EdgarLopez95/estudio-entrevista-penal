{
  "name": "estudio-entrevista-penal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aplicacion local-first de preparacion para entrevista de Abogada Junior en Derecho Penal. Especificacion: CONTRATO_PRODUCTO_ESTUDIO_v5.md",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:hash": "node scripts/verify-excerpts.mjs --write",
    "content:verify": "node scripts/verify-excerpts.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "verify:all": "npm run content:verify && npm run check:contrast && npm run check:offline && npm run test && npm run build",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
